    "# MoE 代码保留供后续实验，当前不使用（见 Block 中 use_moe=False）\n",
    "class MoeMLP(nn.Module):\n",
    "    \"\"\"\n",
    "    Mixture of Experts MLP（实验性，当前不使用）。\n",
    "    \n",
    "    根据 Krajewski et al. (2024) Scaling Laws for Fine-Grained MoE:\n",
    "      MoE 优势随模型规模增大而扩大。在 ~50M 参数级别，\n",
    "      dense model 训练更稳定、可 torch.compile、无专家坍塌风险。\n",
    "    \"\"\"\n",
    "    def __init__(self, config):\n",
    "        super().__init__()\n",
    "        self.n_experts = config.n_experts\n",
    "        self.top_k = config.top_k\n",
    "        self.n_embd = config.n_embd\n",
    "        self.aux_loss_coef = config.aux_loss_coef\n",
    "\n",
    "        self.router = nn.Linear(self.n_embd, self.n_experts, bias=False)\n",
    "        self.experts = nn.ModuleList([MLP(config) for _ in range(self.n_experts)])\n",
    "        self.aux_loss = 0.0\n",
    "\n",
    "    def forward(self, x):\n",
    "        B, T, C = x.shape\n",
    "        x_flat = x.view(-1, C)\n",
    "        N = x_flat.shape[0]\n",
    "        router_logits = self.router(x_flat)\n",
    "        router_probs = F.softmax(router_logits, dim=-1)\n",
    "        topk_vals, topk_ids = torch.topk(router_logits, self.top_k, dim=-1)\n",
    "        topk_gates = F.softmax(topk_vals, dim=-1)\n",
    "        \n",
    "        density = x_flat.new_zeros(N, self.n_experts)\n",
    "        density.scatter_add_(1, topk_ids, topk_gates)\n",
    "        f_i = density.mean(0)\n",
    "        p_i = router_probs.mean(0)\n",
    "        self.aux_loss = self.aux_loss_coef * (self.n_experts * (f_i * p_i).sum())\n",
    "        \n",
    "        output = torch.zeros_like(x_flat)\n",
    "        for idx, expert in enumerate(self.experts):\n",
    "            token_mask = (topk_ids == idx).any(-1)\n",
    "            n_tokens = token_mask.sum().item()\n",
    "            if n_tokens == 0:\n",
    "                continue\n",
    "            expert_in = x_flat[token_mask]\n",
    "            expert_out = expert(expert_in)\n",
    "            expert_hit = (topk_ids[token_mask] == idx)\n",
    "            gate_w = (expert_hit.float() * topk_gates[token_mask]).sum(dim=-1, keepdim=True)\n",
    "            output[token_mask] += gate_w * expert_out\n",
    "        return output.view(B, T, C)"
   ]
  },
