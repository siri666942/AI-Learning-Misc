    "@dataclass\n",
    "class GPTConfig:\n",
    "    block_size: int = 256\n",
    "    vocab_size: int = 13312\n",
    "    n_layer: int = 10    # Muennighoff 数据受限: 降低深度优先于宽度\n",
    "    n_head: int = 9      # 576/9=64 per head (GPT-2 标准)\n",
    "    n_embd: int = 576    # Shakespeare(384)←我们→GPT2-small(768)\n",
    "    dropout: float = 0.2\n",
    "    bias: bool = False   # 节省 ~8M 不必要的参数"
   ]
